--- a/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c	2026-07-31 00:43:51.261744520 +0200
+++ b/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c	2026-07-31 00:44:47.811484740 +0200
@@ -4951,6 +4951,70 @@
                       devId);
         }
 
+        // PCIe Gen2: directed speed change via XP LTSSM
+        // PLM gates (XVE_PLM, XVE_CYA_PLM, XVE_FUSE_OVR, XVE_CYA_SPD, XVE_TARGET)
+        // are already opened by the main plmTable above.
+        {
+            NvU32 xpCfg0   = GPU_REG_RD32(pGpu, 0x0008C040U);
+            NvU32 xpLctrl2 = GPU_REG_RD32(pGpu, 0x0008C1C0U);
+            NvU32 xpCya0   = GPU_REG_RD32(pGpu, 0x0008C2C0U);
+
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: PCIe pre: CFG0=0x%08x LCTRL2=0x%08x CYA0=0x%08x\n",
+                      xpCfg0, xpLctrl2, xpCya0);
+
+            GPU_REG_WR32(pGpu, 0x0008C2C0U, xpCya0 & ~0x00802005U);
+            GPU_REG_WR32(pGpu, 0x0008C040U, (xpCfg0 & ~0xC0000U) | 0x80000U);
+            GPU_REG_WR32(pGpu, 0x0008C1C0U, (xpLctrl2 & ~0xF0000U) | 0x20000U);
+
+            {
+                OBJCL *pCl = SYS_GET_CL(SYS_GET_INSTANCE());
+                PORTDATA *pUpPort = &pGpu->gpuClData.upstreamPort;
+                if (pCl != NULL && pUpPort->addr.valid)
+                {
+                    NvU32 lnkCtl2Off = pUpPort->PCIECapPtr + 0x30U;
+                    NvU16 rpLnkCtl2 = clPcieReadWord(pCl,
+                        pUpPort->addr.domain, pUpPort->addr.bus,
+                        pUpPort->addr.device, pUpPort->addr.func, lnkCtl2Off);
+                    NvU16 rpLnkCtl2New = (rpLnkCtl2 & ~0xFU) | 0x2U;
+                    clPcieWriteWord(pCl,
+                        pUpPort->addr.domain, pUpPort->addr.bus,
+                        pUpPort->addr.device, pUpPort->addr.func,
+                        lnkCtl2Off, rpLnkCtl2New);
+                    NV_PRINTF(LEVEL_ERROR,
+                              "SEC2_DEBUG: PCIe root port LnkCtl2 @ 0x%x: 0x%04x -> 0x%04x\n",
+                              lnkCtl2Off, rpLnkCtl2, rpLnkCtl2New);
+                }
+            }
+
+            {
+                NvU32 cfg0Now = GPU_REG_RD32(pGpu, 0x0008C040U);
+                NvU32 cfg0After;
+                NvU32 linkCtrlStat;
+                NvU32 i;
+
+                GPU_REG_WR32(pGpu, 0x0008C040U, (cfg0Now & ~0xFU) | 0x1U);
+
+                for (i = 0; i < 50; i++)
+                {
+                    osDelay(10);
+                    if ((GPU_REG_RD32(pGpu, 0x0008C040U) & 0x10U) == 0)
+                        break;
+                }
+
+                cfg0After = GPU_REG_RD32(pGpu, 0x0008C040U);
+                GPU_REG_WR32(pGpu, 0x0008C040U, cfg0After & ~0xFU);
+
+                linkCtrlStat = GPU_REG_RD32(pGpu, 0x00088088U);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: PCIe retrain done (polls=%u): "
+                          "LinkCtrlStat=0x%08x speed=%u width=x%u\n",
+                          i, linkCtrlStat,
+                          (linkCtrlStat >> 16) & 0xFU,
+                          (linkCtrlStat >> 20) & 0x3FU);
+            }
+        }
+
         plmStatus = kgspSec2PostblTimingRebuildStockSignature(pGpu, pKernelGsp);
         if (plmStatus != NV_OK)
         {
